# Chettinad Care v2 Compose reference. Copy to .env.compose and set real secrets.
# Requires hospital HTTPS ingress -> 127.0.0.1:8080, not a public HTTP login.
# Never run the demo seeder in this deployment.
NODE_ENV=production
APP_ENV=restricted_web_pilot
PORT=3001
FRONTEND_PORT=8080

# Compose private-network PostgreSQL. Match URL-encoded password in DATABASE_URL.
# Choose random hex passwords to avoid URL / env-file escaping mistakes.
POSTGRES_USER=chettinad
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=chettinad_care
DB_DIALECT=postgres
DATABASE_URL=postgres://chettinad:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/chettinad_care
# Private container-network connection only. Use verified TLS for remote PG.
DATABASE_SSL=false
DATABASE_SSL_CA=
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_HEX
# Same public origin through HTTPS ingress. Cross-site hosts require none + secure.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ORIGIN=https://care.REPLACE_WITH_HOSPITAL_DOMAIN

# Hospital SMS adapter, approved templates and credentials must be provisioned.
SMS_WEBHOOK_URL=https://REPLACE_WITH_HOSPITAL_SMS_ADAPTER/dispatch
SMS_WEBHOOK_TOKEN=REPLACE_WITH_HOSPITAL_SMS_ADAPTER_TOKEN
OPD_NOTIFICATION_WORKER=true

BOOTSTRAP_ADMIN_ID=hospital_admin
BOOTSTRAP_ADMIN_NAME=Hospital Administrator
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_HOSPITAL_ADMIN_PASSWORD

OPD_DEMO_OTP=false
PILOT_AUTH_BYPASS=false
ALLOW_SEED_RESET=false
ENABLE_LEGACY_API=false
