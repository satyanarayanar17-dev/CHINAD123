# Chettinad Care v2 backend configuration reference.
# The backend reads PROCESS ENVIRONMENT; it does not load this file automatically.
# For local file loading: node --env-file=/absolute/path/local.env backend/server.js
# Keep actual values out of source control and frontend VITE_ variables.
NODE_ENV=development
APP_ENV=local_dev
PORT=3001

# SQLite is local-only. Locked deployments require PostgreSQL.
DB_DIALECT=sqlite
SQLITE_PATH=verification.db
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:URL_ENCODED_PASSWORD@host:5432/chettinad_care
DATABASE_URL=
DATABASE_SSL=false
# Private provider CA, optional PEM with literal or escaped newlines.
DATABASE_SSL_CA=
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000

# Required in production: generate a random secret with openssl rand -hex 32.
JWT_SECRET=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Production: exact bare HTTPS frontend origin(s), comma separated.
CORS_ORIGIN=

# Patient OTP transport must be selected explicitly for deployed environments:
# development (requires OPD_DEMO_OTP=true), webhook, or msg91.
OTP_DELIVERY_PROVIDER=
# Webhook adapter must accept authenticated HTTPS POST {phone,template,variables}.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# MSG91 V5 Flow SMS. Keep the auth key server-side. OTP variable name is
# case-sensitive and must exactly match the approved MSG91 Flow template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=
OPD_NOTIFICATION_WORKER=true

# Only local_dev may use a freshly generated OTP displayed by the login UI.
OPD_DEMO_OTP=false
PILOT_AUTH_BYPASS=false
ALLOW_SEED_RESET=false
ENABLE_LEGACY_API=false

# First admin only, when none exists. Use hospital-managed strong credentials.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Legacy local activation APIs only; irrelevant to the v2 patient OTP flow.
ACTIVATION_OTP_DELIVERY=api_response

# Locked deployments require durable private files and encrypted recovery.
PERSISTENT_DATA_ROOT=/var/data
PATIENT_DOCUMENT_STORAGE_PATH=/var/data/patient-documents
BACKUP_ENCRYPTION_KEY=
# Verified internet TLS; render_private only for Render internal database hosts.
DATABASE_TLS_MODE=verified
# Render ingress only; use verified proxy CIDRs elsewhere.
TRUST_PROXY=1
CLINICAL_RULES_APPROVED=false
CLINICAL_PROTOCOL_VERSION=
