# =============================================================================
# CHETTINAD CARE v2 — STAGING ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file and set real values through your hosting provider's secret
# management. NEVER commit actual secrets to source control.
# =============================================================================

NODE_ENV=production
APP_ENV=staging
PORT=3001

# --- Database (managed PostgreSQL) ---
DB_DIALECT=postgres
DATABASE_URL=postgres://user:PASSWORD@host:5432/chettinad_staging
DATABASE_SSL=true
# DATABASE_SSL_CA=  # Optional: PEM CA cert for private providers
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000

# --- Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Cookies ---
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- CORS ---
# Exact bare HTTPS origin of the staging React frontend.
CORS_ORIGIN=https://your-staging-frontend.onrender.com

# --- Patient OTP delivery ---
# This template uses real MSG91 delivery. Populate secrets through the hosting
# provider, and use the exact case-sensitive variable from the approved Flow.
OTP_DELIVERY_PROVIDER=msg91
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=
OPD_NOTIFICATION_WORKER=false

# --- Staging testing ---
OPD_DEMO_OTP=false

# --- Security locks ---
PILOT_AUTH_BYPASS=false
ALLOW_SEED_RESET=false
ENABLE_LEGACY_API=false

# --- Bootstrap admin (first deploy only) ---
BOOTSTRAP_ADMIN_ID=staging_admin
BOOTSTRAP_ADMIN_NAME=Staging Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# Locked deployments require durable private files and encrypted recovery.
PERSISTENT_DATA_ROOT=/var/data
PATIENT_DOCUMENT_STORAGE_PATH=/var/data/patient-documents
BACKUP_ENCRYPTION_KEY=
# Verified internet TLS; render_private only for Render internal database hosts.
DATABASE_TLS_MODE=verified
# Render ingress only; use verified proxy CIDRs elsewhere.
TRUST_PROXY=1
CLINICAL_RULES_APPROVED=false
CLINICAL_PROTOCOL_VERSION=
